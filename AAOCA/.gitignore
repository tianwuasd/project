# Code-only allowlist. Keep all clinical data and run outputs local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/一键处理说明.md
!/独立转换器说明.md
!/requirements.txt
!/一键处理.cmd
!/common.py
!/convert_ct.py
!/convert_us.py
!/pipeline_gui.py
!/run_pipeline.py
!/run_project.py
!/repair_policy.py
!/AGENTS.md
!/PROJECT_HISTORY.md
!/项目升级使用说明.md
!/tools/
!/patient_pipeline/
!/tests/
/patient_pipeline/*
!/patient_pipeline/*.py
/tests/*
!/tests/test_*.py
/tools/*
!/tools/research_ct/
/tools/research_ct/*
!/tools/research_ct/*.py
!/tools/research_ct/README.md
!/tools/research_ct/requirements.txt
__pycache__/
*.py[cod]
