# Code-only allowlist. Keep all clinical data and run outputs local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/一键处理说明.md
!/独立转换器说明.md
!/requirements.txt
!/requirements-preprocess.txt
!/pyproject.toml
!/PREPROCESSING.md
!/PREPROCESSING_WORKFLOW.md
!/preprocess_aaoca.py
!/preprocess_server.sh
!/aaoca_preprocessing/
!/aaoca_server/
!/start_aaoca_server.py
!/start_aaoca_server.sh
!/start_segmentation.py
!/start_segmentation.sh
!/SEGMENTATION_WORKBENCH.md
!/SERVER_WORKBENCH.md
!/一键处理.cmd
!/common.py
!/convert_ct.py
!/convert_us.py
!/pipeline_gui.py
!/run_pipeline.py
!/run_project.py
!/repair_policy.py
!/AGENTS.md
!/PROJECT_HISTORY.md
!/项目升级使用说明.md
!/tools/
!/patient_pipeline/
!/tests/
/patient_pipeline/*
!/patient_pipeline/*.py
/tests/*
!/tests/test_*.py
/aaoca_preprocessing/*
!/aaoca_preprocessing/*.py
/aaoca_server/*
!/aaoca_server/*.py
/tools/*
!/tools/research_ct/
!/tools/chd_dataset/
!/tools/coarse_segmentation/
/tools/coarse_segmentation/*
!/tools/coarse_segmentation/.gitignore
!/tools/coarse_segmentation/README.md
!/tools/coarse_segmentation/requirements*.txt
!/tools/coarse_segmentation/run.py
!/tools/coarse_segmentation/server.py
!/tools/coarse_segmentation/launch_job.py
!/tools/coarse_segmentation/queue_job.py
!/tools/coarse_segmentation/aaoca_seg/
!/tools/coarse_segmentation/tests/
!/tools/coarse_segmentation/web/
!/tools/coarse_segmentation/docs/
!/tools/coarse_segmentation/examples/
/tools/research_ct/*
!/tools/research_ct/*.py
!/tools/research_ct/README.md
!/tools/research_ct/requirements.txt
/tools/chd_dataset/*
!/tools/chd_dataset/*.py
!/tools/chd_dataset/README.md
!/tools/chd_dataset/requirements.txt
__pycache__/
*.py[cod]
