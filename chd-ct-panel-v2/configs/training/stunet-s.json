{
  "model": "stunet-s",
  "protocol": "imagechd-stunet-s-ft-partial-v1",
  "epochs": 1000,
  "train_steps_per_epoch": 250,
  "validation_steps_per_epoch": 50,
  "batch_size": 4,
  "patch_size": [128, 128, 128],
  "initial_lr": 0.001,
  "weight_decay": 0.00003,
  "momentum": 0.99,
  "nesterov": true,
  "poly_power": 0.9,
  "gradient_clip": 12.0,
  "oversample_foreground": 0.33,
  "batch_dice": true,
  "dice_smooth": 0.00001,
  "amp": true,
  "seed": 42,
  "include_auxiliary": true,
  "sampling": "uniform_cases_in_main_train_plus_auxiliary",
  "supported_world_size": 1,
  "nnunet_version": "2.8.1"
}
